{
  // Deliberately standalone rather than extending the app's tsconfig: these
  // files run on Node under @vercel/node, not in the browser through Vite, so
  // they must not inherit the DOM libs, the "@/*" alias, or
  // allowImportingTsExtensions.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
